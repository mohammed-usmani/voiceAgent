LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Outbound SIP trunk for calling phone numbers (+E.164). SIP addresses don't need it.
SIP_OUTBOUND_TRUNK_ID=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# LLMs (voice agent and screening backend): Together AI
TOGETHER_API_KEY=
# Optional: TypeSafe's Jev decision model for rubric scoring, reviewer checks and live question
# progress. Without it the LLM scorer, LLM reviewer and word-overlap matcher are used.
TYPESAFE_API_KEY=
# SIP address the agent calls with `uv run voiceagent-call`, e.g. you@sip.linphone.org
CALL_TO=

# Screening backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/screening
SCREENING_API_KEY=change-me

# Outcome email. Without SMTP_HOST nothing is sent: messages stay in the database and log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
